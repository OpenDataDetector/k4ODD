# Pinned Pandora particle-flow stack for ODD reconstruction + CI.
# Single bump point: change a REF here, regenerate CI references in the same PR.
#
# CI and production build EXACTLY these refs (org forks), so what is tested is what ships.
# The LCContent ref carries the byte-identical mu=200 optimizations (5.66x, see
# doc/OPTIMIZATION_LOG.md); the PandoraSDK ref adds opt-in PANDORA_ALG_TIMING profiling
# (zero overhead when unset); the k4GaudiPandora ref carries the O(N+M) truth-link fix
# and the ACTS track-state handling.

export PANDORASDK_REPO="https://github.com/OpenDataDetector/PandoraSDK.git"
export PANDORASDK_REF="colliderml-v03-04-01-timing.1"

export LCCONTENT_REPO="https://github.com/OpenDataDetector/LCContent.git"
export LCCONTENT_REF="colliderml-v03-02-00-opt.1"

export K4GAUDIPANDORA_REPO="https://github.com/OpenDataDetector/k4GaudiPandora.git"
export K4GAUDIPANDORA_REF="colliderml-odd-edits.1"

# k4DetectorPerformance (k4performance): PFONtuple-based particle-flow evaluation.
# All PF physics evaluations and CI metrics are computed from its PFONtuple output.
export K4DETPERFORMANCE_REPO="https://github.com/OpenDataDetector/k4DetectorPerformance.git"
export K4DETPERFORMANCE_REF="colliderml/pfontuple"
