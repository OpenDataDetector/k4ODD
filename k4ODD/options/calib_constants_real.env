# Stage 2 calibrated calo scale (em_factor=1.0127, had_factor=1.4237)
# R1 FIX (2026-06-01): the hadronic correction was over-loaded onto ECAL->Had (1.587), which
# over-boosted EM-shower leakage -> high-E gamma/e over-response (E100 1.35-1.57). Rebalanced to
# ECAL->Had=1.10 (EM leakage no longer over-scaled) + HCAL->Had=2.05 (hadrons recover; they are
# HCAL-dominated). Validated: gamma E100 1.35->1.03, E200/eta2 1.57->1.09, e- 1.50->1.00;
# neutron 0.99, kaon0L 1.02. Old values kept in comments below.
export K4ODD_ECAL_REALISTIC_DIGI=1
export K4ODD_HCAL_REALISTIC_DIGI=1
export K4ODD_ECAL_EM_SCALE=1.0307411173318997
export K4ODD_HCAL_EM_SCALE=1.0307411173318997
export K4ODD_ECAL_HAD_SCALE_BARREL=1.19    # 1.10 before the ODD calo layer-data fix
export K4ODD_ECAL_HAD_SCALE_ENDCAP=1.19    # 1.10 before the ODD calo layer-data fix
export K4ODD_HCAL_HAD_SCALE=2.05           # 1.90 before the fix; low-E mu cliff was the track-association bug
